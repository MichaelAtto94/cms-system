PORT=4000
# Address recipients can reach when opening password reset emails.
APP_URL=http://localhost:4000
JWT_SECRET=replace-with-random-secret-at-least-32-characters
# Leave blank for embedded PostgreSQL. Docker uses the PostgreSQL service.
DATABASE_URL=
DATA_DIR=./data
ADMIN_EMAIL=admin@cms.local
ADMIN_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Committee Office <office@cms.local>
REQUIRE_2FA=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# AI remains disabled until the administrator enables it in Settings.

